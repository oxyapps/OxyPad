[Desktop Entry]
Type=Application
Name=OxyPad
GenericName=Text Editor
Comment=Fast, native text editor with tabs, sessions and a tail -f log mode
Exec=oxypad %F
Icon=org.oxyapps.oxypad
Terminal=false
Categories=Utility;TextEditor;Development;
