<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- OxyPad.app's Info.plist; package.sh fills in @VERSION@ and @BUILD@. -->
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>OxyPad</string>
    <key>CFBundleDisplayName</key>
    <string>OxyPad</string>
    <key>CFBundleIdentifier</key>
    <string>org.oxyapps.oxypad</string>
    <key>CFBundleExecutable</key>
    <string>oxypad</string>
    <key>CFBundleIconFile</key>
    <string>OxyPad</string>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <!-- The interface languages (crates/app/locales), so the system's own
         panels (open, save) match them. -->
    <key>CFBundleLocalizations</key>
    <array>
        <string>en</string>
        <string>pt-BR</string>
    </array>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>@VERSION@</string>
    <key>CFBundleVersion</key>
    <string>@BUILD@</string>
    <!-- Keep in sync with MACOSX_DEPLOYMENT_TARGET in package.sh. -->
    <key>LSMinimumSystemVersion</key>
    <string>11.0</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.developer-tools</string>
    <key>NSHighResolutionCapable</key>
    <true/>
</dict>
</plist>
